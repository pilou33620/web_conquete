{"nodes": [{"id": "readme", "label": "README web_conquete (Conqu\u00eate : Aquitaine 1700-1899)", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_python_local_server", "label": "Serveur Python local (server.py, boucle de simulation 10 pas/s)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Python 3.8+ sans biblioth\u00e8que \u00e0 installer : tourne sur Windows, Linux, Android (Termux), Raspberry Pi et iPad (Pyto)."}, {"id": "readme_web_interface", "label": "Interface web (HTML/CSS/JS, rendu canvas de la carte)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_auto_update", "label": "Mise \u00e0 jour automatique via git (avance rapide seulement)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Avance rapide seulement pour garder les sauvegardes intactes ; sans r\u00e9seau ou sans cl\u00e9, d\u00e9marre avec la version actuelle sans invite bloquante ; mise de c\u00f4t\u00e9 si des fichiers ont \u00e9t\u00e9 modifi\u00e9s \u00e0 la main."}, {"id": "readme_raspberry_pi_service", "label": "Service systemd web_conquete sur Raspberry Pi (iPad comme \u00e9cran)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Le Pi ne fait que la simulation, le dessin se fait sur l'iPad ; pas de mot de passe, donc r\u00e9seau domestique seulement."}, {"id": "readme_single_game_multi_screen", "label": "Une partie par serveur, plusieurs \u00e9crans", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PC et iPad voient et commandent la m\u00eame partie : on commence sur l'un, on continue sur l'autre."}, {"id": "readme_autosave", "label": "Sauvegarde automatique au d\u00e9but de chaque mois (saves/)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Apr\u00e8s une coupure de courant, le Raspberry reprend la partie telle quelle, en pause."}, {"id": "readme_map_cache", "label": "Cache de carte game/data/map_cache.json", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Calcul de la carte 3-4 s sur PC, 15-30 s sur Pi : mis en cache, recalcul\u00e9 apr\u00e8s un changement de game/geo.py."}, {"id": "readme_turn_based_monthly", "label": "Tour par tour mois par mois (votre tour, puis le tour des IA)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u00c0 la Civilization / Empire: Total War ; m\u00e9nage le Raspberry (0,4 s de calcul par mois sur PC, 2-4 s sur Pi pour 15 s \u00e0 l'\u00e9cran)."}, {"id": "readme_ai_turn_interruptions", "label": "Interruptions du tour des IA (anti-r\u00e9p\u00e9tition)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Laisser le joueur r\u00e9agir aux moments cl\u00e9s sans interruptions \u00e0 r\u00e9p\u00e9tition (d\u00e9lais minimaux par bataille, si\u00e8ge, arm\u00e9e, lieu, proposition)."}, {"id": "readme_monthly_recap", "label": "R\u00e9capitulatif du mois", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_realtime_mode", "label": "Temps r\u00e9el avec pause (r\u00e9glage avanc\u00e9)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_eras_and_starts", "label": "\u00c9poques et d\u00e9parts 1700/1790/1813/1870", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_dated_technologies", "label": "Technologies dat\u00e9es et armement par \u00e9poque (r\u00e9armement)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_population_trajectories", "label": "Population historique sur deux si\u00e8cles", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_prestige", "label": "Prestige et fin de partie au 1er janvier 1900", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rayonnement \u00e9quilibr\u00e9 pour gagner par la paix comme par la guerre ; population plafonn\u00e9e \u00e0 25 000 habitants par ville."}, {"id": "readme_historical_events", "label": "\u00c9v\u00e9nements historiques \u00e0 choix (une trentaine, 1701-1898)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_treaties", "label": "Trait\u00e9s plut\u00f4t qu'an\u00e9antissement", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "