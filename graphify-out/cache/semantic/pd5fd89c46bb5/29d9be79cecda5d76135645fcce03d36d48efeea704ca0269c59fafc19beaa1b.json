{"nodes": [{"id": "readme", "label": "README web_conquete (Conqu\u00eate : Aquitaine 1700-1899)", "file_type": "document", "source_file": "README.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_python_local_server", "label": "Serveur Python local (server.py, boucle de simulation 10 pas/s)", "file_type": "concept", "source_file": "README.md", "source_location": "L7-23", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Python 3.8+ seul, aucune biblioth\u00e8que : tourne partout (Windows, Linux, Termux, Raspberry Pi, Pyto) ; l'interface est une page web."}, {"id": "readme_auto_update", "label": "Mise \u00e0 jour automatique via git (avance rapide seulement)", "file_type": "rationale", "source_file": "README.md", "source_location": "L25-31", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Avance rapide seulement pour garder les sauvegardes intactes ; aucune invite de mot de passe ne bloque le d\u00e9marrage ; mise de c\u00f4t\u00e9 si des fichiers ont \u00e9t\u00e9 modifi\u00e9s \u00e0 la main."}, {"id": "readme_raspberry_pi_service", "label": "Service systemd web_conquete sur Raspberry Pi (iPad comme \u00e9cran)", "file_type": "concept", "source_file": "README.md", "source_location": "L33-80", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Le Raspberry ne fait que la simulation, le dessin se fait sur l'iPad ; le tour par tour m\u00e9nage le Pi (2 \u00e0 4 s de calcul par mois)."}, {"id": "readme_single_game_multi_screen", "label": "Une partie par serveur, plusieurs \u00e9crans", "file_type": "rationale", "source_file": "README.md", "source_location": "L65-66,123-124", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Commencer sur l'ordinateur et continuer sur l'iPad : les deux voient et commandent le m\u00eame tour."}, {"id": "readme_autosave", "label": "Sauvegarde automatique au d\u00e9but de chaque mois (saves/)", "file_type": "concept", "source_file": "README.md", "source_location": "L71-72,125-126", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_map_cache", "label": "Cache de carte game/data/map_cache.json", "file_type": "concept", "source_file": "README.md", "source_location": "L78-80", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_turn_based_monthly", "label": "Tour par tour mois par mois (votre tour, puis le tour des IA)", "file_type": "rationale", "source_file": "README.md", "source_location": "L84-129", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u00c0 la mani\u00e8re de Civilization ou Empire : Total War ; chaque ordre s'ex\u00e9cute tout de suite, puis le mois des IA se joue en acc\u00e9l\u00e9r\u00e9 (15 s par mois)."}, {"id": "readme_ai_turn_interruptions", "label": "Interruptions du tour des IA (anti-r\u00e9p\u00e9tition)", "file_type": "rationale", "source_file": "README.md", "source_location": "L99-114", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Laisser r\u00e9agir aux moments cl\u00e9s (bataille, invasion, si\u00e8ge, d\u00e9cision) sans arr\u00eats \u00e0 r\u00e9p\u00e9tition : d\u00e9lais minimaux par bataille, si\u00e8ge, lieu, arm\u00e9e, proposition."}, {"id": "readme_tutorial", "label": "Tutoriel \u00e0 bulles (premiers pas, armes en bataille)", "file_type": "concept", "source_file": "README.md", "source_location": "L115-118", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_monthly_recap", "label": "R\u00e9capitulatif du mois", "file_type": "concept", "source_file": "README.md", "source_location": "L119-122", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_realtime_mode", "label":