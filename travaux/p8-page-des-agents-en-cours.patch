+//! Une partie d'essai pour la page des agents (SPEC-POLITIQUE, module 4, page P8) : la Gironde (Aquitaine, 1790) en guerre
+//! contre les Landes, Bordeaux avec un bureau de douane, une paroisse et un collège (espion, prêtre, gentilhomme et diplomate
+//! s'y forment), de quoi payer ; Mont-de-Marsan avec des remparts (à saboter). Dans Bordeaux : un gentilhomme, un prêtre et un
+//! diplomate à nous, un gentilhomme landais (duel, dénonciation) et un espion landais démasqué (assassinat). La page y forme un
+//! espion, l'envoie saboter, livre un duel, poste le prêtre et envoie le diplomate en ambassade à Périgueux.
+//! Écrit la sauvegarde là où le dit CONQUETE_PARTIE_AGENTS (un chemin de fichier .json) :
+//! `CONQUETE_PARTIE_AGENTS=$PWD/saves/essai-agents.json cargo test --release -p conquete --test partie_agents -- --ignored`
+
+mod fabrique_campagne;
+
+use conquete::cities as CT;
+use conquete::diplomacy as D;
+use conquete::engine::agents as AG;
+use conquete::py::{json, Val};
+use conquete::views as V;
+use conquete::dict;
+use fabrique_campagne::partie;
+
+#[test]
+#[ignore]
+fn partie_agents() {
+    let Some(chemin) = std::env::var_os("CONQUETE_PARTIE_AGENTS") else { return };
+    let mut g = partie();
+    let p = g.player.clone();
+    D::declare_war(&mut g, "40", &p, true);
+    let (bdx, mdm) = (g.capital_of(&p).i(), g.capital_of("40").i());
+    let n = g.nodes.at(bdx);
+    for (ch, l) in [("douane", 1), ("eglise", 1), ("universite", 1)] {
+        CT::slots(&n).set(ch, l);
+    }
+    n.set("stab", 0.45);
+    g.nodes.at(mdm).set("fort", 1);
+    g.factions.at(&p).at("res").set("livres", 20000);
+    for t in ["gentilhomme", "pretre", "diplomate"] {
+        AG::nouvel_agent(&mut g, &p, t, bdx);
+    }
+    AG::nouvel_agent(&mut g, "40", "gentilhomme", bdx);
+    AG::nouvel_agent(&mut g, "40", "espion", bdx).set("cache", false);
+    let meta = dict! {"player" => &p, "faction" => g.fname(&p), "date" => g.date_str(&Val::None), "t" => g.t, "difficulty" => "normal", "auto" => false};
+    let data = dict! {"meta" => meta, "game" => V::to_dict(&mut g)};
+    std::fs::write(chemin, json::dumps_avec(&data, json::Ecriture::default())).unwrap();
+}
diff --git a/tests/agents.test.mjs b/tests/agents.test.mjs
new file mode 100644
index 0000000..3f521bb
--- /dev/null
+++ b/tests/agents.test.mjs
@@ -0,0 +1,46 @@
+// Banc des agents côté page (SPEC-POLITIQUE, module 4, page P8) : node --test tests/
+//
+// POURQUOI CE BANC EXISTE. La réponse du moteur à une mission n'est qu'un message ({ok, msg}) : la page en déduit la scène à
+// jouer et si elle est réussie. Un message lu de travers jouerait un duel gagné pour un duel perdu, ou un sabotage réussi pour
+// un agent pris, sans que rien ne plante. Et le recrutement grisé doit dire la même raison que le moteur (agents::peut_recruter).
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { installer } from './dom.mjs';
+
+installer();
+const { issueMission, recrue, SCENE_MISSION } = await import('../web/js/agents.js');
+
+test('chaque mission du moteur a sa scène de web_engine', () => {
+  const scenes = new Set(['duel', 'sabotage', 'assassinat', 'espionnage', 'apaisement', 'diplomate', 'pris']);   // (TYPES_MISSION)
+  for (const m of ['espionner', 'saboter_remparts', 'saboter_batiment', 'saboter_armee', 'assassiner', 'inciter', 'duel', 'universite', 'voler_tech', 'apaiser', 'denoncer', 'ambassade'])
+    assert.ok(scenes.has(SCENE_MISSION[m]), m);
+});
+
+test('l’issue d’une mission d’après le message du moteur', () => {
+  assert.deepEqual(issueMission('saboter_remparts', 'Sabotage réussi à Mont-de-Marsan.'), { type: 'sabotage', reussite: true });
+  assert.deepEqual(issueMission('saboter_remparts', 'Échec : Jean Garat a été pris.'), { type: 'pris', reussite: false });
+  assert.deepEqual(issueMission('assassiner', 'Échec : Jean Garat a été tué à Dax.'), { type: 'assassinat', reussite: false });
+  assert.deepEqual(issueMission('espionner', 'Échec : Jean Garat s\'est échappé, démasqué.'), { type: 'espionnage', reussite: false });
+  // au duel, le vainqueur est nommé le premier
+  assert.equal(issueMission('duel', 'Duel : Paul Roux tue Jean Bel en duel.', 'Paul Roux').reussite, true);
+  assert.equal(issueMission('duel', 'Duel : Jean Bel blesse Paul Roux ; il gardera la chambre deux tours.', 'Paul Roux').reussite, false);
+  // dénoncer : l'agent étranger est emmené par les gardes
+  assert.deepEqual(issueMission('denoncer', 'Jean Garat est arrêté.'), { type: 'pris', reussite: false, eux: true });
+  assert.equal(issueMission('inconnue', 'x'), null);
+});
+
+test('recrutement : bâtiment, plafond, file, livres', () => {
+  const R = { AGENTS: {
+    espion: { cout: 120, batiments: [['douane', 1], ['port', 1], ['marche', 1]] },
+    diplomate: { cout: 200, batiments: [['capitale', 1], ['douane', 3]] },
+  } };
+  const st = { me: { code: '33', res: { livres: 150 } }, agents_camp: { espion: { n: 0, plafond: 1 }, diplomate: { n: 0, plafond: 1 } } };
+  const ville = { type: 'ville', dept: '33' }, cap = { type: 'capitale', dept: '33' };
+  assert.deepEqual(recrue(R, st, ville, { slots: { douane: 1 } }, 'espion'), { ok: true, why: '' });
+  assert.match(recrue(R, st, ville, { slots: {} }, 'espion').why, /^Il faut dans la place : douane ou port ou marche/);
+  assert.match(recrue(R, st, ville, { slots: {} }, 'diplomate').why, /votre capitale/);
+  assert.match(recrue(R, st, cap, { slots: {} }, 'diplomate').why, /Livres insuffisantes/);
+  assert.match(recrue(R, st, ville, { slots: { douane: 1 }, q: [1, 2, 3, 4] }, 'espion').why, /File de production pleine/);
+  st.agents_camp.espion.n = 1;
+  assert.match(recrue(R, st, ville, { slots: { douane: 1 } }, 'espion').why, /^Plafond atteint \(1\)/);
+});
diff --git a/web/js/agents.js b/web/js/agents.js
new file mode 100644
index 0000000..9f9e093
--- /dev/null
+++ b/web/js/agents.js
@@ -0,0 +1,340 @@
+// Les agents côté page (SPEC-POLITIQUE, module 4, page P8) : espions, gentilshommes, prêtres et diplomates sur la carte.
+// Sélection d'un agent, sa fenêtre (traits, mission en poste, ordres, missions possibles avec leur chance de réussite),
+// recrutement dans le panneau de la place, fenêtre d'un agent étranger (et les missions de nos agents qui peuvent le viser),
+// scène de la mission jouée (sceneMission de web_engine, par hex/agents.js) puis son résultat. Les figurines sont dessinées
+// par graphismes/rendu/agents.js (via hex/agents.js) ; ici, du HTML, et de loin un pion 2D (pastille et icône du type).
+// Contrat du moteur : state.agents, state.agents_camp ; rules.AGENTS, rules.MISSIONS, rules.agent_traits, rules.agent_ordre ;
+// commandes {cmd: "agent", sub: "recruter" | "deplacer" | "mission" | "chance" | "annuler", …} qui rendent {ok, msg}.
+import { esc } from './battle/formes.js';
+import { ICON } from './icons.js';
+import { partTour } from './map.js';
+import { placer } from './hex/agents.js';
+
+const SVG = body => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${body}</svg>`;
+// une icône par type (le pion de loin, la fenêtre, le recrutement)
+export const ICONE_AGENT = {
+  espion: ICON.spy,
+  gentilhomme: ICON.swords,
+  pretre: SVG('<path d="M12 3v18"/><path d="M7 8.5h10"/><path d="M8.5 21h7"/>'),
+  diplomate: ICON.diplo,
+};
+const XP = [0, 2, 5, 9, 14];   // expérience des niveaux 1 à 5 (rules.rs AGENT_XP, que rules_payload ne donne pas)
+// la scène de web_engine (TYPES_MISSION) de chaque mission ; sans scène propre, la plus proche : inciter (fumée et troubles)
+// → sabotage ; voler une technologie → espionnage ; poste à l'université → diplomate reçu (l'accueil, drapeau hissé)
+export const SCENE_MISSION = {
+  espionner: 'espionnage', saboter_remparts: 'sabotage', saboter_batiment: 'sabotage', saboter_armee: 'sabotage', inciter: 'sabotage',
+  assassiner: 'assassinat', duel: 'duel', voler_tech: 'espionnage', universite: 'diplomate', apaiser: 'apaisement', denoncer: 'pris',
+  ambassade: 'diplomate',
+};
+
+/** L'issue d'une mission d'après la réponse du moteur ({ok, msg} : le message dit ce qui s'est passé) : la scène à jouer et
+ *  si elle est réussie. nom : celui de notre agent (au duel, le vainqueur est nommé le premier). Rend null sans scène. */
+export function issueMission(mission, msg = '', nom = '') {
+  const type = SCENE_MISSION[mission];
+  if (!type) return null;
+  if (/^Échec/.test(msg)) return /a été pris/.test(msg) ? { type: 'pris', reussite: false } : { type, reussite: false };
+  if (mission === 'duel') return { type, reussite: msg.startsWith(`Duel : ${nom} `) };
+  // la dénonciation réussie : l'agent étranger est pris (les gardes l'emmènent : « pris » manqué, vu de lui)
+  if (mission === 'denoncer') return { type, reussite: false, eux: true };
+  return { type, reussite: true };
+}
+
+/** Peut-on former cet agent dans cette place ? (comme agents::peut_recruter du moteur, d'après la vue) : {ok, why}. */
+export function recrue(R, st, gn, ns, type, nomBat = (k, l) => k) {
+  const A = R.AGENTS[type], me = st.me.code, c = st.agents_camp?.[type] || { n: 0, plafond: 1 };
+  const ici = A.batiments.some(([k, l]) => k === 'capitale' ? gn.type === 'capitale' && gn.dept === me : (ns.slots?.[k] || 0) >= l);
+  if (!ici) return { ok: false, why: `Il faut dans la place : ${A.batiments.map(([k, l]) => k === 'capitale' ? 'votre capitale' : nomBat(k, l).toLowerCase()).join(' ou ')}` };
+  if (c.n >= c.plafond) return { ok: false, why: `Plafond atteint (${c.plafond}) : bâtissez d’autres ${type === 'diplomate' ? 'comptoirs' : 'bâtiments'} de niveau 2 pour en avoir plus` };
+  if (ns.sg) return { ok: false, why: 'La place est assiégée' };
+  if ((ns.q || []).length >= 4) return { ok: false, why: 'File de production pleine (4 maximum)' };
+  if ((st.me.res.livres || 0) < A.cout) return { ok: false, why: 'Livres insuffisantes' };
+  return { ok: true, why: '' };
+}
+
+// l'image d'une icône, pour le pion de loin (canevas) : blanche, gardée
+const IMG = new Map();
+function iconeImg(type) {
+  if (typeof Image === 'undefined') return null;
+  let im = IMG.get(type);
+  if (!im) {
+    im = new Image();
+    im.src = 'data:image/svg+xml,' + encodeURIComponent(ICONE_AGENT[type].replace('<svg', '<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" style="color:#fff"'));
+    IMG.set(type, im);
+  }
+  return im.complete && im.naturalWidth ? im : null;
+}
+
+export class Agents {
+  constructor(ui) {
+    this.ui = ui;
+    this.vise = null;     // ordre qui attend un toucher sur la carte : { id, mode: 'deplacer' | 'cible', mission }
+    this.essai = null;    // la chance demandée pour une cible touchée : { id, mission, cible, ok, chance, msg }
+  }
+  get st() { return this.ui.st; }
+  get R() { return this.ui.rules; }
+  get plateau() { return this.ui.map.hex ? this.ui.map.plateau?.agents || null : null; }
+  liste() { return placer(this.st?.agents || [], this.ui.md.nodes); }
+  get(id) { return this.liste().find(a => a.id === id); }
+  mien(a) { return a && a.proprio === this.st.me.code; }
+  cmd(sub, body, toast = true) { return this.ui.cmd({ cmd: 'agent', sub, ...body }, toast); }
+  nomType(t) { return this.R.AGENTS?.[t]?.nom || t; }
+  nomPlace(id) { return this.ui.md.nodes[id]?.name || ''; }
+  // ce que vise une mission : une place (numéro), une armée (« a… ») ou un agent (« ag… »)
+  nomCible(c) {
+    if (typeof c === 'number') return this.nomPlace(c);
+    const b = this.get(c);
+    if (b) return `${b.nom} (${this.nomType(b.type).toLowerCase()})`;
+    return this.ui.armyById(c)?.name || c;
+  }
+  pos(id) { const a = this.get(id); return a ? this.ou(a) : null; }
+  // l'agent sur la carte : là où le plateau pose sa figurine, sinon sa case
+  ou(a) { return this.plateau?.pos(a.id) || a.case; }
+
+  // ------------------------------------------------------------------ carte (map.js hitTest, draw)
+  // à l'écran : la figurine de près ; de loin, le pion à côté de sa place (en rang avec les autres agents qui y sont)
+  ecran(a) {
+    const m = this.ui.map, p3 = this.plateau?.pos(a.id);
+    if (p3) return [...m.toScreen(p3[0], p3[1]), true];
+    if (a.at_node == null || !this.ui.md.nodes[a.at_node]) return [...m.toScreen(a.case[0], a.case[1]), false];
+    const n = this.ui.md.nodes[a.at_node], [x, y] = m.toScreen(n.x, n.y), s = m.nodeSize(n);
+    const ici = this.liste().filter(b => b.at_node === a.at_node), i = ici.indexOf(a);
+    return [x + s * 0.5 + 10 + i * 21, y - s * 0.4, false];
+  }
+  touche(sx, sy, pad) {
+    let best = null;
+    const r3 = Math.max(10, this.plateau?.rayonPx || 0);
+    for (const a of this.liste()) {
+      const [x, y, p3] = this.ecran(a), d = Math.hypot(sx - x, sy - (p3 ? y - r3 * 0.6 : y));
+      if (d < (p3 ? r3 : 11) + pad && (!best || d < best.d)) best = { kind: 'agent', id: a.id, d };
+    }
+    return best;
+  }
+  dessin(ctx) {
+    const m = this.ui.map, s = this.ui.sel, r3 = Math.max(10, this.plateau?.rayonPx || 0);
+    ctx.save();
+    for (const a of this.liste()) {
+      const [x, y, p3] = this.ecran(a);
+      if (x < -40 || y < -40 || x > m.vw + 40 || y > m.vh + 40) continue;
+      const sel = s?.kind === 'agent' && s.id === a.id, col = m.colors[a.proprio] || '#888';
+      if (sel && a.chemin?.length) {   // la route de notre agent choisi
+        ctx.strokeStyle = 'rgba(243,217,142,0.85)'; ctx.lineWidth = 2; ctx.setLineDash([5, 6]);
+        ctx.beginPath(); ctx.moveTo(x, y);
+        for (const nid of a.chemin) { const n = this.ui.md.nodes[nid]; if (n) ctx.lineTo(...m.toScreen(n.x, n.y)); }
+        ctx.stroke(); ctx.setLineDash([]);
+      }
+      if (p3) {   // la figurine 3D : l'anneau de sélection et l'étiquette
+        if (sel) { ctx.strokeStyle = '#f3d98e'; ctx.lineWidth = 2.5; ctx.beginPath(); ctx.ellipse(x, y, r3, r3 * 0.54, 0, 0, Math.PI * 2); ctx.stroke(); }
+        if (sel || this.mien(a) && !this.liste().some(b => b !== a && b.at_node != null && b.at_node === a.at_node)) this.etiquette(ctx, a, x, y + Math.max(12, r3 * 0.7));   // (en groupe : le nom du choisi seulement)
+        continue;
+      }
+      // le pion : pastille à la couleur du camp, l'icône du type ; caché : bord en pointillés
+      if (sel) { ctx.strokeStyle = '#f3d98e'; ctx.lineWidth = 2.5; ctx.beginPath(); ctx.arc(x, y, 14, 0, Math.PI * 2); ctx.stroke(); }
+      ctx.fillStyle = 'rgba(0,0,0,.35)'; ctx.beginPath(); ctx.arc(x + 1, y + 1.5, 10, 0, Math.PI * 2); ctx.fill();
