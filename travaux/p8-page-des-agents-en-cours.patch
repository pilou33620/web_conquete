+// Les agents de près sur le plateau (SPEC-POLITIQUE, module 4, page P8) : chacun en figurine de web_engine
+// (graphismes/rendu/agents.js, maillageAgent) à la couleur de son camp, à l'habit de l'époque, son niveau en étoiles sur le
+// socle, translucide s'il se cache, qui marche quand il se déplace ; à la même échelle et à partir du même zoom que les troupes
+// (hex/armees.js). Dans une place, les agents se tiennent ensemble sur un hexagone libre près d'elle (comme les armées au
+// bivouac) ; en chemin, là où ils sont. De loin, le pion 2D de agents.js reste. Et les scènes de mission (sceneMission).
+// Ce fichier ne dessine rien : il pose et oriente les figurines du moteur. Une par agent, gardée tant que son type, son camp,
+// son niveau et l'époque ne changent pas (marche et cache se changent sans rien rebâtir).
+import { TROUPES_PX } from './armees.js';
+
+const ECH = 0.18;    // l'échelle des troupes (hex/armees.js)
+
+// la vue ne donne at_node que pour nos agents : un agent étranger arrêté dans une place a la case de la place ; posé une
+// fois par état (nodes : les places de la carte)
+const VUS = new WeakSet();
+export function placer(liste, nodes) {
+  if (VUS.has(liste)) return liste;
+  VUS.add(liste);
+  for (const a of liste) if (a.at_node === undefined) a.at_node = nodes.find(n => Math.abs(n.x - a.case[0]) < 1e-3 && Math.abs(n.y - a.case[1]) < 1e-3)?.id ?? null;
+  return liste;
+}
+
+export class AgentsPlateau {
+  // pl : le plateau (hex/plateau.js) ; E : les modules du moteur ; Ag : graphismes/rendu/agents.js ; epoqueDe : an → époque
+  constructor(pl, E, Ag, epoqueDe) {
+    this.pl = pl; this.E = E; this.Ag = Ag; this.epoqueDe = epoqueDe;
+    this.groupe = new E.S.THREE.Group(); E.S.scene.add(this.groupe);
+    this.vues = new Map();   // id de l'agent → { grp, cle, x, y, cap } (x, y : où il est posé, en unités du jeu)
+    this.pres = false;       // les agents sont-ils des figurines (lu par agents.js)
+    this.rayonPx = 0;        // demi-largeur d'une figurine à l'écran (anneau de sélection, toucher)
+    this.finScene = 0;       // fin de la dernière scène de mission (le plateau se redessine jusque-là)
+  }
+  // chaque image, avant le rendu : rend vrai si quelque chose a bougé
+  maj(cam) {
+    const pl = this.pl, mp = pl.mp, N = pl.N, f = pl.fen, st = mp.state;
+    const pres = !!(st && f && N && !N.leger && !mp.papierVu?.() && N.pas * cam.z >= TROUPES_PX);
+    let bouge = pres !== this.pres || performance.now() < this.finScene;
+    this.pres = pres; this.groupe.visible = pres;
+    if (!pres) return bouge;
+    const Ag = this.Ag, epoque = this.epoqueDe(st.year || 1700), leger = this.E.S.qualite.niveau === 'leger';
+    this.rayonPx = 1.6 * ECH * cam.z * f.u;   // (la figurine et son socle : un peu plus de 2 unités du modèle de large)
+    const liste = placer(st.agents || [], mp.nodes), vus = new Set();
+    for (const a of liste) {
+      vus.add(a.id);
+      const couleur = mp.colors[a.proprio] || '#999999', cle = `${a.type}|${couleur}|${epoque}|${a.niveau}|${leger}`;
+      let v = this.vues.get(a.id);
+      if (!v || v.cle !== cle) {
+        if (v) Ag.jeterAgent(v.grp);
+        v = { grp: Ag.maillageAgent({ type: a.type, couleur, epoque, niveau: a.niveau, cache: !!a.cache, leger }), cle, x: v?.x, y: v?.y, cap: v?.cap ?? 0.35 };
+        v.grp.scale.setScalar(ECH); this.groupe.add(v.grp); this.vues.set(a.id, v);
+        bouge = true;
+      }
+      // vers sa place : il y glisse en marchant, tourné vers où il va ; arrêté, face à la caméra
+      let [x, y] = this.place(a, liste);
+      const marche = v.x != null && Math.hypot(x - v.x, y - v.y) > 0.03;
+      if (marche) { v.cap = Math.atan2(x - v.x, y - v.y); x = v.x + (x - v.x) * 0.12; y = v.y + (y - v.y) * 0.12; bouge = true; }
+      else if (v.x != null && v.cap !== 0.35) { v.cap = 0.35; bouge = true; }
+      const g = v.grp, X = x / f.u - f.ox, Z = y / f.u - f.oz;
+      g.userData.marche = marche; g.userData.cache = !!a.cache;
+      g.position.set(X, Math.max(this.E.P.hauteurEn(X, Z), 0), Z); g.rotation.y = v.cap;
+      v.x = x; v.y = y;
+    }
+    for (const [id, v] of this.vues) if (!vus.has(id)) { this.Ag.jeterAgent(v.grp); this.vues.delete(id); bouge = true; }
+    return bouge;
+  }
+  // où poser l'agent (unités du jeu) : en chemin, sa case ; dans une place, l'hexagone libre qui suit ceux de ses armées
+  // (hex/armees.js place), les agents de la place en petit groupe (trois par rang)
+  place(a, liste) {
+    if (a.at_node == null) return a.case;
+    const slot = (this.pl.mp.state.armies || []).filter(x => x.n === a.at_node && x.st !== 'battle').length;
+    const [cx, cy] = this.pl.armees.place({ a: { n: a.at_node }, slot, x: a.case[0], y: a.case[1] });
+    const ici = liste.filter(b => b.at_node === a.at_node), i = ici.indexOf(a), n = Math.min(3, ici.length), pas = this.pl.N.pas * 0.26;
+    const rang = Math.floor(i / 3), rangs = Math.ceil(ici.length / 3), dans = rang < rangs - 1 ? n : ici.length - rang * 3;
+    return [cx + (i % 3 - (dans - 1) / 2) * pas, cy + (rang - (rangs - 1) / 2 - 0.8) * pas * 0.8];   // (dans le haut de l'hexagone : le nom de la place, dessous, ne les cache pas)
+  }
+  // l'agent posé en figurine : où il est (unités du jeu), ou null
+  pos(id) { const v = this.pres && this.vues.get(id); return v ? [v.x, v.y] : null; }
+  // une scène de mission au point (x, y) du jeu (o : type, reussite, couleurs, agent), un peu devant le groupe des agents
+  // (dans le bas de leur hexagone) ; rend sa durée (ms)
+  scene(o) {
+    const f = this.pl.fen;
+    if (!f) return 0;
+    const X = o.x / f.u - f.ox, Z = (o.y + (this.pl.N?.pas || 4) * 0.22) / f.u - f.oz;
+    const ms = this.Ag.sceneMission({ type: o.type, position: [X, Math.max(this.E.P.hauteurEn(X, Z), 0), Z], couleurs: o.couleurs, reussite: o.reussite,
+      epoque: this.epoqueDe(this.pl.mp.state?.year || 1700), echelle: ECH, agent: o.agent });
+    this.finScene = Math.max(this.finScene, performance.now() + ms);
+    return ms;
+  }
+  dispose() { this.Ag.finirMissions(); this.E.S.scene.remove(this.groupe); }
+}
